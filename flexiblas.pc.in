prefix=@prefix@
libdir=@libdir@
includedir=${prefix}/include/${flexiblasname}
fcflags=-I${includedir} @PKGCONF_VAR_INTEGER8@
i8cflag=@PKGCONF_VAR_INTEGER8@
i8=@PKGCONF_VAR_I8@
backenddir=${libdir}/@FLEXIBLAS_LIBRARY_DIR@
rcdir="@CMAKE_INSTALL_FULL_SYSCONFDIR@/@FLEXIBLAS_RC_DIR@"
Name: flexiblas
Description: BLAS wrapper library mimicing Netlib Reference but providing any installed BLAS Implementation
Version: @FLEXIBLAS_VERSION@
URL: http://www.mpi-magdeburg.mpg.de/mpcsc/software/FlexiBLAS/
Libs: -L${libdir} -l${flexiblasname}
Libs.private: -lm
Cflags: -I${includedir} @PKGCONF_VAR_INTEGER8@

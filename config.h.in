#define TLS_STORE _Thread_local
#elif defined(HAVE_THREAD_LOCAL)
#define TLS_STORE thread_local
#else
#define TLS_STORE
#if __STDC_VERSION__ >= 202311L
#warning Thread Local Storage not available. FlexiBLAS might cause problems in multithreaded applications.
#endif
#endif

